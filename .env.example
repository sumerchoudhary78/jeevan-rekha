# Meta Model API key (dev.meta.ai -> API keys). Needs a payment method on file.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Triage LLM (extraction, duplicate judge, photo scene). Any OpenAI-compatible endpoint.
# Default: open-weights Muse Spark Open on Baseten. For hosted Muse Spark instead:
#   LLM_BASE_URL=https://api.meta.ai/v1  LLM_MODEL=muse-spark-1.3  LLM_API_KEY= (empty reuses MODEL_API_KEY)
# Or self-hosted Muse Glimmer on Modal: see deploy/modal_glimmer.py
LLM_BASE_URL=https://inference.baseten.co/v1
LLM_MODEL=meta-models/muse-spark-open-1026
# Your Baseten key:
LLM_API_KEY=

# Live call-taker conversation: low-latency hosted Muse Spark (empty key reuses MODEL_API_KEY).
AGENT_LLM_BASE_URL=https://api.meta.ai/v1
AGENT_LLM_MODEL=muse-spark-1.3
AGENT_LLM_API_KEY=
